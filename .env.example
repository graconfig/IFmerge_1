# SAP AI Core 配置(必填)
AICORE_AUTH_URL=https://<your-tenant>.authentication.<region>.hana.ondemand.com/oauth/token
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=https://api.ai.<region>.aws.ml.hana.ondemand.com/v2
AICORE_RESOURCE_GROUP=default
AICORE_DEPLOYMENT_ID=

# 工具配置(可选;打包后留空则默认 exe 同级目录的 input/ 与 output/)
# INPUT_DIR=input
# OUTPUT_DIR=output

# 参照文件(可选;打包后留空则使用随包自带的模板)
# TEMPLATE_PATH=reference/IF抽出_新フォーマット.xlsx
# REFERENCE_PATH=reference/本社EBS現行IF一覧.xlsx

# AI 分析参数(可选)
PHASE1_HEAD_ROWS=30
MAX_CHUNK_ROWS=100

# 日志级别(可选): DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
